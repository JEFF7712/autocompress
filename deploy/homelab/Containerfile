# Harness image for the homelab runner: clang-17 toolchain (upstream fx2-cmix
# names), uv, git. The autocompress repo is cloned at runtime onto the PVC so
# experiments flow without image rebuilds.
#
# UNTESTED DRAFT (2026-07-06): the cluster is down; build and validate before
# first deploy: podman build -t jeff7712/autocompress-runner:0.1.0 -f Containerfile .

FROM ubuntu:22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg git make upx-ucl util-linux xz-utils \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key \
        | gpg --dearmor -o /usr/share/keyrings/llvm.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/jammy/ llvm-toolchain-jammy-17 main" \
        > /etc/apt/sources.list.d/llvm17.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        clang-17 llvm-17 \
    && rm -rf /var/lib/apt/lists/*

# Upstream build scripts call clang++-17 and llvm-profdata-17; the llvm.org
# packages already install those exact names. upx-ucl comes from apt.

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN useradd -m -u 1000 runner
USER 1000
WORKDIR /work

ENTRYPOINT ["/bin/bash", "-lc"]
CMD ["./entrypoint.sh"]
