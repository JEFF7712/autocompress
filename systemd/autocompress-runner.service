[Unit]
Description=autocompress benchmark runner

[Service]
Type=exec
WorkingDirectory=/home/rupan/projects/autocompress
# uv, nix, git, systemd-run must all resolve; the bare user-manager PATH does
# not include the nix profiles, so set it explicitly.
Environment=PATH=/etc/profiles/per-user/rupan/bin:/run/current-system/sw/bin:/usr/bin:/bin
ExecStart=/etc/profiles/per-user/rupan/bin/uv run runner.py
Nice=10
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
